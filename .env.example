# LLM 설정 — .env에 복사해서 사용. OpenAI 호환 API면 뭐든 됨.
# Upstage Solar (기본, 파트너사): https://api.upstage.ai/v1
# 모델 별칭: solar-pro4(최신 flagship) / solar-pro3(이전 flagship, 코드 기본값) / solar-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_MODEL=solar-pro3

# OpenAI 대안:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
